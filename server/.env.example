# Copy this file to .env and fill it in. Never push .env to GitHub.

PORT=5000
NODE_ENV=development

# MongoDB Atlas → Connect → Drivers → copy the connection string.
# Put the database name (biohelix) before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/biohelix?retryWrites=true&w=majority

# Long random text (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cloudinary → Dashboard → API Keys (needed for student photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Cloud service account (needed to read Google Form result sheets).
# Paste the private key on ONE line, keeping the \n parts, inside double quotes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# SMS through sms.net.bd (Alpha SMS) → panel → API. Leave empty to keep SMS off.
SMS_API_KEY=
# Optional: approved sender name (e.g. BioHelix)
SMS_SENDER_ID=
# The website address, used in result SMS (e.g. https://biohelix-xxxx.code.run)
PUBLIC_URL=
